  (should-not (lookup-key qq-chat-mode-map (kbd "M-s"))))

(ert-deftest qq-chat-search-real-timeline-jump-keeps-context-draft-and-read-position ()
  (let ((qq-state-change-hook nil)
        (qq-media-cache-update-hook nil)
        (qq-runtime--accounts (make-hash-table :test #'equal))
        (qq-account--accounts (make-hash-table :test #'equal))
        (qq-state--partitions (make-hash-table :test #'equal))
        (qq-state--active-account-id nil)
        (qq-chat-show-prompt-avatar nil)
        (qq-request--active (make-hash-table :test #'eq))
        success buffer)
    (puthash "slot-a" '((account_id . "slot-a") (uin . "10002") (uid . "u_self"))
             qq-account--accounts)
    (cl-letf (((symbol-function 'qq-server-gateway-instance-id) (lambda () "gateway-a"))
              ((symbol-function 'qq-server-ready-p) (lambda () t))
              ((symbol-function 'qq-server-capabilities)
               (lambda () '("message.search_adjacent")))
              ((symbol-function 'qq-server-send)
               (lambda (_method _params callback _errback &optional _early)
                 (setq success callback) "search-smoke"))
              ((symbol-function 'qq-server-cancel) #'ignore))
      (unwind-protect
          (qq-runtime-with-account "slot-a"
            (qq-state-reset)
            (qq-state-upsert-session "group:20001"
                                     '((type . group) (target-id . "20001")
                                       (title . "Search test")) nil)
            (dolist (row '("16" "17" "18"))
              (qq-state--merge-normalized-message
               "group:20001"
               `((id . ,row) (canonical-row-key . ,row) (canonical-timeline-class . "authored")
                 (server-id . ,row) (session-key . "group:20001")
                 (time . ,(+ 1784700000 (string-to-number row)))
                 (message-seq . ,row) (sender-id . "10001") (sender-name . "Alice")
                 (self-p . nil) (status . received) (message-type . "group")
                 (segments . (((type . "text") (data . ((text . "中文 surrounding context"))))))
                 (raw-message . "中文 surrounding context")
                 (preview . "中文 surrounding context") (order . ,(string-to-number row)))))
            (setq buffer (qq-chat--open-buffer "group:20001"))
            (with-current-buffer buffer
              (qq-chat-test--window "16" "18")
              (qq-chat-render)
              (qq-chat--set-draft "unfinished 中文 draft")
              (qq-chat--goto-loaded-message "16")
              (setq qq-chat--last-read-target-row-key "15")
              (let ((before (copy-tree (qq-state-session-messages "group:20001"))))
                (qq-chat-search "中文" t)
                (should success)
                (funcall success (qq-chat-search-test-result "17" "中文" "newer"))
                (should (equal (alist-get 'canonical-row-key (qq-chat--message-at-point)) "17"))
                (should (equal (ring-ref qq-chat--messages-pop-ring 0)
                               '((kind . "row") (row_key . "16"))))
                (should (equal qq-chat--last-read-target-row-key "15"))
                (should (equal before (qq-state-session-messages "group:20001")))
                (should (equal "unfinished 中文 draft" (qq-chat--current-draft-string)))
                (should qq-chat-search--overlays)
                (let ((count (length qq-chat-search--overlays)))
                  (qq-chat--request-row-redisplay '("17"))
                  (should (= count (length qq-chat-search--overlays)))
                  (should (cl-every #'overlay-buffer qq-chat-search--overlays))
                  (let ((mark-active t))
                    (qq-chat--request-row-redisplay '("17")))
                  (qq-chat--flush-deferred-node-redisplay)
                  (should (= count (length qq-chat-search--overlays)))
                  (should (cl-every #'overlay-buffer qq-chat-search--overlays)))
                (qq-chat-search-cancel)
                (should-not qq-chat-search--overlays)
                (should (equal "17" (alist-get 'canonical-row-key (qq-chat--message-at-point))))
                (should (equal "unfinished 中文 draft" (qq-chat--current-draft-string))))))
        (when (buffer-live-p buffer) (kill-buffer buffer))
        (qq-runtime-stop-account "slot-a" t)
        (qq-state-reset)))))

(ert-deftest qq-chat-search-repeated-navigation-advances-pending-hit-unless-point-moved ()
  (dolist (move '(repeat manual goto))
    (qq-chat-search-test-with-ui
      (setq at-point '((canonical-row-key . "20") (session-key . "group:20001")))
      (qq-chat-search "中文")
      (funcall (plist-get (car calls) :success) (qq-chat-search-test-result "17"))
      (should (equal qq-chat--pending-jump-center '((kind . "row") (row_key . "17"))))
      (pcase move
        ('manual
         (setq at-point '((canonical-row-key . "19") (session-key . "group:20001"))))
        ('goto
         (setq qq-chat--jump-owner (list 'user-jump)
               qq-chat--pending-jump-center '((kind . "row") (row_key . "21")))))
      (qq-chat-search-next)
      (should (equal (alist-get 'center (plist-get (nth 1 calls) :params))
                     `((kind . "row")
                       (row_key . ,(pcase move ('repeat "17") ('manual "19") ('goto "20")))))))))
(ert-deftest qq-chat-search-envelope-uses-json-conversation-identity ()
  ;; The Gateway serializes objects through serde_json::Value.  A group's
  ;; group_uin precedes kind on the wire; JSON member order is not identity.
  (dolist (case '(("{\"group_uin\":\"20001\",\"kind\":\"group\"}" "group:20001")
                  ("{\"kind\":\"group\",\"group_uin\":\"20001\"}" "group:20001")
                  ("{\"kind\":\"private\",\"peer_uin\":\"10001\"}" "private:10001")
                  ("{\"peer_uin\":\"10001\",\"kind\":\"private\"}" "private:10001")))
    (let ((result
           (json-parse-string
            (format "{\"account_id\":\"slot-a\",\"conversation\":%s,\"direction\":\"older\",\"gateway_instance_id\":\"gateway-a\",\"hit\":null,\"query\":\"中文\"}"
                    (car case))
            :object-type 'alist :null-object nil :false-object :false)))
      (should-not (qq-chat-search--check-result
                   result "slot-a" (cadr case) "中文" "older" "gateway-a" nil))
      (should-error (qq-chat-search--check-result
                     result "slot-a" "group:99999" "中文" "older" "gateway-a" nil))
      (dolist (conversation '(((group_uin . "20001") (kind . "group") (extra . t))
                              ((group_uin . 20001) (kind . "group"))
                              ((group_uin . "20001") (kind . "group") (kind . "group"))))
        (setf (alist-get 'conversation result) conversation)
        (should-error (qq-chat-search--check-result
                       result "slot-a" "group:20001" "中文" "older" "gateway-a" nil))))))

(ert-deftest qq-chat-search-keys-start-and-continue-in-the-requested-direction ()
  (qq-chat-search-test-with-ui
    (let ((prompts 0))
      (cl-letf (((symbol-function 'read-string)
                 (lambda (&rest _) (cl-incf prompts) "中文")))
        ;; Directional starters do not depend on a prefix argument.
        (let ((current-prefix-arg '(4)))
          (call-interactively (key-binding (kbd "C-c C-r"))))
        (should (equal (alist-get 'direction (plist-get (car calls) :params)) "older"))
        (funcall (plist-get (car calls) :success) (qq-chat-search-test-result "17"))
        (call-interactively (key-binding (kbd "M-g n")))
        (should (equal (alist-get 'direction (plist-get (nth 1 calls) :params)) "newer"))
        (should (equal (alist-get 'center (plist-get (nth 1 calls) :params))
                       '((kind . "row") (row_key . "17"))))
        (funcall (plist-get (nth 1 calls) :success)
                 (qq-chat-search-test-result "19" "中文" "newer"))
        (call-interactively (key-binding (kbd "M-g p")))
        (should (equal (alist-get 'direction (plist-get (nth 2 calls) :params)) "older"))
        (should (= prompts 1))
        (qq-chat-search-cancel)
        (call-interactively (key-binding (kbd "C-c C-s")))
        (should (equal (alist-get 'direction (plist-get (nth 3 calls) :params)) "newer"))
        (qq-chat-search-cancel)
        (call-interactively (key-binding (kbd "M-g n")))
        (should (equal (alist-get 'direction (plist-get (nth 4 calls) :params)) "newer"))
        (should (= prompts 3))
        (let ((hint (qq-chat-search-status)))
          (should (string-match-p "M-g p / M-g n" hint))
          (should (string-match-p
                   (regexp-quote (substitute-command-keys "\\<qq-chat-mode-map>\\[qq-chat-cancel-dwim]"))
                   hint))
          (should-not (string-match-p "M-s" hint)))))))

(ert-deftest qq-chat-search-cancel-preserves-reply-and-draft-while-reply-close-is-specific ()
  (qq-chat-search-test-with-ui
    (let ((reply 'reply-target) (draft "unfinished message") card)
      (cl-letf (((symbol-function 'qq-chat--reply-message) (lambda () reply))
                ((symbol-function 'qq-chat--set-reply-message) (lambda (value) (setq reply value)))
                ((symbol-function 'qq-chat--current-draft-string) (lambda () draft))
                ((symbol-function 'qq-chat-clear-draft) (lambda () (setq draft "")))
                ((symbol-function 'qq-chat--update-frame) #'ignore)
                ((symbol-function 'appkit-chatbuf-input-history-active-p) (lambda () nil))
                ((symbol-function 'qq-message-reply-target) (lambda (&rest _) t))
                ((symbol-function 'qq-chat--message-sender-display-parts) (lambda (_) '("Sender")))
                ((symbol-function 'qq-chat--message-title-face) (lambda (_) 'default))
                ((symbol-function 'qq-state-message-preview) (lambda (_) "Reply body"))
                ((symbol-function 'qq-media-message-one-line-preview) (lambda (_ preview) preview))
                ((symbol-function 'qq-chat--line-fill-column) (lambda () 80))
                ((symbol-function 'appkit-chatbuf-aux-render) (lambda (&rest args) (setq card args))))
        (qq-chat-search "中文")
        (call-interactively (key-binding (kbd "C-c C-k")))
        (should-not qq-chat-search--query)
        (should (eq reply 'reply-target))
        (should (equal draft "unfinished message"))
        (call-interactively (key-binding (kbd "C-c C-k")))
        (should-not reply)
        (should (equal draft "unfinished message"))
        (call-interactively (key-binding (kbd "C-c C-k")))
        (should (string-empty-p draft))
        ;; The explicit reply close button never consumes an active search.
        (setq reply 'reply-target draft "another draft")
        (qq-chat-search "中文")
        (qq-chat--reply-context-text)
        (funcall (plist-get card :cancel-action))
        (should-not reply)
        (should (equal qq-chat-search--query "中文"))
        (should (equal draft "another draft"))))))

