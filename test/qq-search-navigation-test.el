;;; qq-search-navigation-test.el --- Adjacent chat search tests -*- lexical-binding: t; -*-

(require 'qq-chat-test)
(require 'ert)
(require 'qq-search-navigation)

(defun qq-chat-search-test-item (&optional row)
  `((conversation . ((kind . "group") (group_uin . "20001")))
    (kind . "native") (row_key . ,(or row "17"))
    (timeline_class . "authored") (recalled . :false)
    (message
     . ((message_id . nil) (sent_at . 1784700000)
        (sender . ((uin . "10001") (uid . "u_peer")))
        (conversation . ((kind . "group") (group_uin . "20001")))
        (sequence . "9007199254740999")
        (segments . [((kind . "text") (payload . ((text . "中文 [a.*] QQ é É"))))])))))

(defun qq-chat-search-test-result (&optional row query direction)
  `((gateway_instance_id . "gateway-a") (account_id . "slot-a")
    (conversation . ((group_uin . "20001") (kind . "group")))
    (query . ,(or query "中文")) (direction . ,(or direction "older"))
    (hit . ,(when row (qq-chat-search-test-item row)))))

(defmacro qq-chat-search-test-with-ui (&rest body)
  "Run BODY across real RPC/request boundaries with a controlled transport."
  (declare (indent 0) (debug t))
  `(with-temp-buffer
     (qq-chat-mode)
     (let* ((buffer (current-buffer))
            (view (appkit-surface--create :buffer buffer :alive-p t))
            (qq-state--self-info '((user_id . "10002")))
            (qq-request--active (make-hash-table :test #'eq))
            (instance "gateway-a")
            (at-point nil) calls cancelled jumps jump-token)
       (setq qq-runtime--account-id "slot-a"
             qq-chat--session-key "group:20001")
       (cl-letf (((symbol-function 'qq-account-get)
                  (lambda (owner)
                    (and (equal owner "slot-a")
                         '((account_id . "slot-a") (uin . "10002")
                           (uid . "u_self") (phase . "online")))))
                 ((symbol-function 'qq-runtime-call-with-account)
                  (lambda (_owner function) (funcall function)))
                 ((symbol-function 'qq-server-gateway-instance-id) (lambda () instance))
                 ((symbol-function 'qq-server-ready-p) (lambda () t))
                 ((symbol-function 'qq-server-capabilities)
                  (lambda () '("message.search_adjacent")))
                 ((symbol-function 'qq-chat--live-current-view) (lambda () view))
                 ((symbol-function 'qq-chat--captured-view-current-p)
                  (lambda (candidate) (eq view candidate)))
                 ((symbol-function 'appkit-register-handle) (lambda (&rest _) nil))
                 ((symbol-function 'qq-chat--header-line-update) #'ignore)
                 ((symbol-function 'qq-chat--message-at-point) (lambda (&rest _) at-point))
                 ((symbol-function 'qq-chat-goto-message)
                  (lambda (center &optional _)
                    (push center jumps)
                    (setq qq-chat--pending-jump-center center
                          qq-chat--jump-owner (list 'jump center nil)
                          jump-token qq-chat--jump-owner)))
                 ((symbol-function 'qq-chat--cancel-jump)
                  (lambda (owner)
                    (when (eq owner jump-token) (setq jump-token nil))))
                 ((symbol-function 'qq-server-cancel)
                  (lambda (token) (push token cancelled)))
                 ((symbol-function 'qq-server-send)
                  (lambda (method params success failure &optional _early)
                    (let ((token (format "navigate-%d" (1+ (length calls)))))
                      (setq calls (append calls (list (list :method method :params params
                                                            :success success :failure failure
                                                            :token token))))
                      token))))
         (unwind-protect (progn ,@body) (qq-chat-search-cancel))))))

(ert-deftest qq-chat-search-navigates-from-point-and-last-hit-with-exact-rows ()
  (qq-chat-search-test-with-ui
    (setq at-point '((canonical-row-key . "18") (session-key . "group:20001")))
    (qq-chat-search " 中文 ")
    (should (equal (plist-get (car calls) :method) "message.search_adjacent"))
    (should (equal (alist-get 'center (plist-get (car calls) :params))
                   '((kind . "row") (row_key . "18"))))
    (funcall (plist-get (car calls) :success) (qq-chat-search-test-result "17"))
    (should (equal (car jumps) '((kind . "row") (row_key . "17"))))
    (should-not qq-chat-search--loading)
    (setq at-point nil)
    (qq-chat-search-previous)
    (should (equal (alist-get 'center (plist-get (nth 1 calls) :params))
                   '((kind . "row") (row_key . "17"))))
    (funcall (plist-get (nth 1 calls) :success) (qq-chat-search-test-result "16"))
    (setq at-point '((canonical-row-key . "15") (session-key . "group:20001")))
    (qq-chat-search-next)
    (should (equal (alist-get 'direction (plist-get (nth 2 calls) :params)) "newer"))
    (should (equal (alist-get 'center (plist-get (nth 2 calls) :params))
                   '((kind . "row") (row_key . "15"))))
    (funcall (plist-get (nth 2 calls) :success)
             (qq-chat-search-test-result nil "中文" "newer"))
    (should (equal qq-chat-search--status "没有更新的匹配"))
    (should (= (length jumps) 2))))

(ert-deftest qq-chat-search-composer-starts-at-selected-timeline-end ()
  (qq-chat-search-test-with-ui
    (qq-chat-search "中文")
    (should-not (assq 'center (plist-get (car calls) :params)))
    (should (equal (alist-get 'direction (plist-get (car calls) :params)) "older"))
    (qq-chat-search "中文" t)
    (should-not (assq 'center (plist-get (nth 1 calls) :params)))
    (should (equal (alist-get 'direction (plist-get (nth 1 calls) :params)) "newer"))))

(ert-deftest qq-chat-search-cancellation-and-new-query-own-late-responses ()
  (qq-chat-search-test-with-ui
    (qq-chat-search "中文")
    (qq-chat-search "QQ")
    (funcall (plist-get (car calls) :success) (qq-chat-search-test-result "17"))
    (should-not jumps)
    (should (equal qq-chat-search--query "QQ"))
    (funcall (plist-get (nth 1 calls) :success) (qq-chat-search-test-result "16" "QQ"))
    (should (= (length jumps) 1))
    (should jump-token)
    (qq-chat-search-next)
    (qq-chat-search-cancel)
    (should-not jump-token)
    (funcall (plist-get (nth 2 calls) :success)
             (qq-chat-search-test-result "18" "QQ" "newer"))
    (should (= (length jumps) 1))
    (should-not qq-chat-search--query)
    (should-not (qq-chat-search-status))))

(ert-deftest qq-chat-search-detached-account-session-and-gateway-cannot-jump ()
  (dolist (change '(account session gateway view))
    (qq-chat-search-test-with-ui
      (qq-chat-search "中文")
      (pcase change
	('account (setq qq-runtime--account-id "slot-b"))
	('session (setq qq-chat--session-key "group:20002"))
	('gateway (setq instance "gateway-b"))
	('view (setq view (appkit-surface--create :buffer buffer :alive-p t))))
      (funcall (plist-get (car calls) :success) (qq-chat-search-test-result "17"))
      (should-not jumps)
      (should-error (qq-chat-search-next) :type 'user-error))))

(ert-deftest qq-chat-search-validates-envelope-and-excludes-center-hit ()
  (let ((result (qq-chat-search-test-result "17")))
    (dolist (slot '(account_id gateway_instance_id query direction conversation))
      (let ((wrong (copy-tree result)))
        (setf (alist-get slot wrong) "wrong")
        (should-error (qq-chat-search--check-result
                       wrong "slot-a" "group:20001" "中文" "older" "gateway-a" nil))))
    (should-error (qq-chat-search--check-result
                   result "slot-a" "group:20001" "中文" "older" "gateway-a"
                   '((kind . "row") (row_key . "17"))))
    (let ((wrong (copy-tree result)))
      (setf (alist-get 'conversation (alist-get 'hit wrong))
            '((kind . "private") (peer_uin . "10001")))
      (should-error (qq-chat-search--check-result
                     wrong "slot-a" "group:20001" "中文" "older" "gateway-a" nil)))))

(ert-deftest qq-chat-search-highlights-literal-text-without-touching-composer ()
  (qq-chat-search-test-with-ui
    (let ((inhibit-read-only t))
      (insert (propertize "中文 [a.*] QQ qq é É\n" 'qq-chat-message-anchor "row:17"))
      (insert "draft [a.*] QQ 中文\n"))
    (let ((original (buffer-string)))
      (qq-chat-search "[a.*]")
      (should (= 1 (length qq-chat-search--overlays)))
      (let ((overlay (car qq-chat-search--overlays)))
	(should (equal "[a.*]" (buffer-substring-no-properties
				(overlay-start overlay) (overlay-end overlay)))))
      (qq-chat-search "qQ")
      (should (= 2 (length qq-chat-search--overlays)))
      (qq-chat-search "é")
      (should (= 1 (length qq-chat-search--overlays)))
      (run-hooks 'qq-chat-after-render-hook)
      (should (= 1 (length qq-chat-search--overlays)))
      (should (equal original (buffer-string)))
      (setq instance "gateway-b")
      (run-hooks 'qq-chat-after-render-hook)
      (should-not qq-chat-search--overlays)
      (qq-chat-search-cancel)
      (should (equal original (buffer-string))))))

(ert-deftest qq-chat-search-failure-retains-query-and-last-navigation-center ()
  (qq-chat-search-test-with-ui
    (qq-chat-search "中文")
    (funcall (plist-get (car calls) :success) (qq-chat-search-test-result "17"))
    (qq-chat-search-previous)
    (funcall (plist-get (nth 1 calls) :failure) nil "offline")
    (should (equal qq-chat-search--query "中文"))
    (should (equal qq-chat-search--center '((kind . "row") (row_key . "17"))))
    (should (string-match-p "offline" (qq-chat-search-status)))
    (qq-chat-search-previous)
    (should (equal (alist-get 'center (plist-get (nth 2 calls) :params))
                   '((kind . "row") (row_key . "17"))))))

(ert-deftest qq-chat-jump-owner-cancel-protects-later-jump-to-the-same-row ()
  (with-temp-buffer
    (setq qq-chat--session-key "group:20001")
    (let (history-owner cancelled loaded completed)
      (cl-letf (((symbol-function 'qq-chat--message-at-point) #'ignore)
                ((symbol-function 'qq-chat--finish-jump-if-loaded)
                 (lambda (center)
                   (when loaded
                     (setq qq-chat--pending-jump-center nil)
                     (run-hook-with-args 'qq-chat-message-jump-hook center)
                     t)))
                ((symbol-function 'qq-chat--open-around)
                 (lambda (&rest _) (setq history-owner (list 'history))))
                ((symbol-function 'qq-chat--loading) (lambda () history-owner))
                
                ((symbol-function 'qq-chat--cancel-history-request)
                 (lambda () (push history-owner cancelled) (setq history-owner nil))))
        (let* ((center '((kind . "row") (row_key . "17")))
               (first (qq-chat-goto-message center))
               (second (qq-chat-goto-message center)))
          (should-not (eq first second))
          (qq-chat--cancel-jump first)
          (should (equal qq-chat--pending-jump-center center))
          (should (equal cancelled (list (nth 2 first))))
          (should (eq history-owner (nth 2 second)))
          (qq-chat--cancel-jump second)
          (should-not qq-chat--pending-jump-center)
          (should (= 2 (length cancelled)))
          (setq loaded t)
          (add-hook 'qq-chat-message-jump-hook
                    (lambda (target) (push target completed)) nil t)
          (let ((third (qq-chat-goto-message center)))
            (should (eq third qq-chat--jump-owner))
            (should-not qq-chat--pending-jump-center)
            (should (equal completed (list center))))
          (setq loaded nil)
          (let ((fourth (qq-chat-goto-message center)))
            (setq loaded t)
            (let ((fifth (qq-chat-goto-message center)))
              (should (eq fifth qq-chat--jump-owner))
              (should-not qq-chat--pending-jump-center)
              (should-not history-owner)
              (should (memq (nth 2 fourth) cancelled)))))))))

(ert-deftest qq-chat-search-bindings-preserve-composer-history-and-results-command ()
  (should (eq (lookup-key qq-chat-mode-map (kbd "M-p")) #'qq-chat-draft-prev))
  (should (eq (lookup-key qq-chat-mode-map (kbd "M-n")) #'qq-chat-draft-next))
  (should (eq (lookup-key qq-chat-mode-map (kbd "C-c C-r")) #'qq-chat-search))
  (should (eq (lookup-key qq-chat-mode-map (kbd "C-c C-s")) #'qq-chat-search-forward))
  (should (eq (lookup-key qq-chat-mode-map (kbd "M-g s")) #'qq-chat-search))
  (should (eq (lookup-key qq-chat-mode-map (kbd "M-g p")) #'qq-chat-search-previous))
  (should (eq (lookup-key qq-chat-mode-map (kbd "M-g n")) #'qq-chat-search-next))
  (should (eq (lookup-key qq-chat-mode-map (kbd "C-c /")) #'qq-search-chat))
