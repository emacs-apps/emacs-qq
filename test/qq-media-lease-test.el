;;; qq-media-lease-test.el --- Retained native media index tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'qq-media)
(require 'qq-remote-media-test)
(require 'qq-message-test)
(require 'qq-forward-test)

(ert-deftest qq-media-leases-renew-recover-and-release-independent-tokens ()
  (qq-remote-media-test-with-state
    (let* ((qq-remote-media--lease-aliases (make-hash-table :test #'equal))
           (old qq-remote-media-test-id)
           (restored "media-bbbbbbbb-cccc-4ddd-8eee-ffffffffffff")
           (source '((kind . "message") (account_id . "slot-a")))
           (snapshot (qq-remote-media-test-snapshot))
           (real-timer (symbol-function 'run-at-time))
           (delivered 0) calls callbacks renewals first second)
      (setf (alist-get 'media_id snapshot) restored)
      (cl-letf (((symbol-function 'qq-runtime-current-account-id) (lambda () "slot-a"))
                ((symbol-function 'qq-server-gateway-instance-id) (lambda () "gateway-test"))
                ((symbol-function 'qq-server-ready-p) (lambda () t))
                ((symbol-function 'run-at-time)
                 (lambda (_delay _repeat function &rest args)
                   (push (lambda () (apply function args)) renewals)
                   (funcall real-timer 3600 nil #'ignore)))
                ((symbol-function 'qq-rpc-call)
                 (lambda (method params &rest options)
                   (push (cons method params) calls)
                   (unless (equal method "media.release_lease")
                     (push options callbacks))
                   'lease-request)))
        (cl-labels ((answer (options id)
                      (funcall (plist-get options :callback)
                               `((lease . ((lease_id . ,id) (expires_in . 120)))
                                 (media . ,snapshot)))))
          (unwind-protect
              (progn
                (setq first (qq-remote-media-acquire-lease
                             old source (lambda (_) (cl-incf delivered)) #'ert-fail))
                (answer (car callbacks) "lease-one")
                (setq second (qq-remote-media-acquire-lease
                              old source (lambda (_) (cl-incf delivered)) #'ert-fail))
                (answer (car callbacks) "lease-two")
                (should (= delivered 2))
                (should (equal (qq-remote-media-canonical-id old) restored))
                (should (equal (qq-media--native-record-media-id
                                `((type . "record") (data . ((media_id . ,old)))))
                               old))
                (should (equal (alist-get 'media_id (qq-remote-media old)) restored))
                (let (updates)
                  (cl-letf (((symbol-function 'qq-media--note-cache-updated)
                             (lambda (key) (push key updates))))
                    (qq-media--native-remote-media-changed 'progress restored))
                  (should (member (qq-media--native-record-key old) updates)))
                (funcall (appkit-cancellation-cancel first))
                (should (equal (cdr (car calls)) '((lease_id . "lease-one"))))
                (should (equal (qq-remote-media-canonical-id old) restored))
                ;; Suspend longer than the Gateway TTL: renewal reacquires by source.
                (funcall (car renewals))
                (should (equal (car (car calls)) "media.renew"))
                (funcall (plist-get (car callbacks) :errback)
                         '((code . "media_lease_not_found")) "expired")
                (should (equal (car (car calls)) "media.acquire"))
                (should (equal (alist-get 'source (cdr (car calls))) source))
                (answer (car callbacks) "lease-three")
                (should (= delivered 2))
                (funcall (appkit-cancellation-cancel second))
                (should (equal (qq-remote-media-canonical-id old) old))
                (should (= (hash-table-count qq-remote-media--lease-aliases) 0)))
            (when first (funcall (appkit-cancellation-cancel first)))
            (when second (funcall (appkit-cancellation-cancel second)))))))))

(ert-deftest qq-media-lease-canceled-or-old-connection-reply-cannot-retain ()
  (qq-remote-media-test-with-state
    (let ((qq-remote-media--lease-aliases (make-hash-table :test #'equal))
          callbacks releases)
      (cl-letf (((symbol-function 'qq-runtime-current-account-id) (lambda () "slot-a"))
                ((symbol-function 'qq-server-gateway-instance-id) (lambda () "gateway-test"))
                ((symbol-function 'qq-server-ready-p) (lambda () t))
                ((symbol-function 'qq-rpc-call)
                 (lambda (method params &rest options)
                   (if (equal method "media.release_lease")
                       (push (alist-get 'lease_id params) releases)
                     (push (plist-get options :callback) callbacks))
                   'lease-request)))
        (let ((first (qq-remote-media-acquire-lease
                      qq-remote-media-test-id nil #'ert-fail #'ert-fail)))
          (funcall (appkit-cancellation-cancel first))
          (funcall (car callbacks)
                   `((lease . ((lease_id . "late") (expires_in . 120)))
                     (media . ,(qq-remote-media-test-snapshot))))
          (should (equal releases '("late"))))
        (let ((old (qq-remote-media-acquire-lease
                    qq-remote-media-test-id nil #'ert-fail #'ert-fail)))
          (cl-incf qq-resource--access-generation)
          (funcall (car callbacks)
                   `((lease . ((lease_id . "previous-connection") (expires_in . 120)))
                     (media . ,(qq-remote-media-test-snapshot))))
          (funcall (appkit-cancellation-cancel old))
          (should (equal releases '("late")))
          (should (= (hash-table-count qq-remote-media--lease-aliases) 0)))))))

(ert-deftest qq-media-preparation-restores-id-before-materialization ()
  (qq-remote-media-test-with-part-access
    (let* ((qq-remote-media--lease-aliases (make-hash-table :test #'equal))
           (restored "media-bbbbbbbb-cccc-4ddd-8eee-ffffffffffff")
           (snapshot (qq-remote-media-test-snapshot))
           (source '((kind . "message") (account_id . "slot-a")))
           materialized releases result)
      (setf (alist-get 'media_id snapshot) restored)
      (cl-letf (((symbol-function 'qq-rpc-method-available-p)
                 (lambda (method) (equal method "media.acquire")))
                ((symbol-function 'qq-rpc-call)
                 (lambda (method params &rest options)
                   (pcase method
                     ("media.acquire"
                      (should (equal (alist-get 'source params) source))
                      (funcall (plist-get options :callback)
                               `((lease . ((lease_id . "operation") (expires_in . 120)))
                                 (media . ,snapshot))))
                     ("media.release_lease"
                      (push (alist-get 'lease_id params) releases)))
                   'lease-request))
                ((symbol-function 'qq-remote-media-materialize-part)
                 (lambda (id _part success _failure)
                   (setq materialized id)
                   (funcall success nil) 'materialize)))
        (let ((operation
               (qq-remote-media-prepare-part-local-access
                qq-remote-media-test-id 'content
                (lambda (value) (setq result value)) #'ert-fail source)))
          (should (equal materialized restored))
          (should (equal (qq-remote-media-operation-media-id operation) restored))
          (should-not releases)
          (funcall open-callback)
          (should (equal (alist-get 'media_id result) restored))
          (should (equal releases '("operation")))
          (should (qq-resource-access-grant (alist-get 'lease result)))
          (qq-resource-access-release (alist-get 'lease result)))))))

(ert-deftest qq-media-source-locators-preserve-message-forward-and-dataline-position ()
  (qq-message-test-with-state
    (let* ((media `((kind . "image")
                    (payload . ((media_id . ,qq-remote-media-test-id)))))
           (normal (qq-message-normalize-snapshot
                    (alist-get 'message
                               (qq-message-test-event
                                :segments (list (qq-message-test-text-segment "prefix") media)))
                    "slot-a" (qq-message-test-account)))
           (source (alist-get 'media-source (cadr (alist-get 'segments normal))))
           (data (qq-message-test-dataline-message))
           (forward (car (qq-forward--normalize-messages
                          (list (qq-forward-test--message
                                 "3" "" :segments (list media)))
                          '((kind . "resource") (resource_id . "opaque-forward") (scene . "group"))))))
      (should (equal (alist-get 'kind source) "message"))
      (should (equal (alist-get 'account_id source) "slot-a"))
      (should (equal (alist-get 'conversation source)
                     '((kind . "private") (peer_uin . "10001"))))
      (should (= (alist-get 'segment_index source) 1))
      (setf (alist-get 'segments data) (list media))
      (let* ((normalized (car (qq-message--normalize-dataline-message "slot-a" data)))
             (locator (alist-get 'media-source (car (alist-get 'segments normalized)))))
        (should (equal (alist-get 'kind (alist-get 'conversation locator)) "dataline"))
        (should (equal (alist-get 'center locator)
                       '((kind . "message") (message_id . "7348923749823749823")))))
      (should (equal (alist-get 'media-source (car (alist-get 'segments forward)))
                     '((kind . "forward") (account_id . "slot-a")
                       (resource_id . "opaque-forward") (scene . "group")
                       (entry_id . "3") (segment_index . 0)))))))


(ert-deftest qq-media-viewport-lease-preserves-draft-and-releases-on-scroll ()
  (qq-message-test-with-state
    (qq-remote-media-test-with-state
      (let* ((qq-remote-media--lease-aliases (make-hash-table :test #'equal))
             (session "private:10001")
             (message `((id . "200") (server-id . "200") (session-key . ,session)
                        (sender-name . "Peer") (sender-id . "10001") (time . 1784800000)
                        (segments . (((type . "image")
                                      (data . ((media_id . ,qq-remote-media-test-id))))))))
             (starts 0) releases surface)
        (puthash session (list message) qq-state--messages-by-session)
        (cl-letf (((symbol-function 'qq-server-ready-p) (lambda () t))
                  ((symbol-function 'qq-rpc-method-available-p)
                   (lambda (method) (equal method "media.acquire")))
                  ((symbol-function 'qq-rpc-call)
                   (lambda (method params &rest options)
                     (pcase method
                       ("media.acquire"
                        (cl-incf starts)
                        (funcall (plist-get options :callback)
                                 `((lease . ((lease_id . ,(format "viewport-%d" starts))
                                             (expires_in . 120)))
                                   (media . ,(qq-remote-media-test-snapshot)))))
                       ("media.release_lease"
                        (push (alist-get 'lease_id params) releases)))
                     'lease-request))
                  ((symbol-function 'qq-media--fetch-native-image-part-resource) #'ignore)
                  ((symbol-function 'qq-chat--maybe-auto-load-older) #'ignore)
                  ((symbol-function 'qq-chat--maybe-auto-load-newer) #'ignore)
                  ((symbol-function 'qq-media--visible-row-keys) (lambda (_) '("200"))))
          (save-window-excursion
            (with-temp-buffer
              (qq-chat-mode)
              (qq-runtime-bind-account "slot-a")
              (setq qq-chat--session-key session)
              (qq-chat--set-history-window "200" nil)
              (switch-to-buffer (current-buffer))
              (qq-chat-render)
              (setq surface (appkit-current-surface))
              (qq-chat--set-draft "unfinished draft")
              (appkit-surface-send surface
                                   (list 'qq-render (appkit-projection-change-create :full-p t)))
              (should (= starts 1))
              (should-not releases)
              (appkit-loop-run-pass (appkit-app-loop (appkit-surface-app surface)))
              (appkit-loop-run-pass (appkit-surface-loop surface))
              (should (equal (qq-chat--current-draft-string) "unfinished draft"))
              (cl-letf (((symbol-function 'qq-media--visible-row-keys) (lambda (_) nil)))
                (appkit-surface-send surface
                                     (list 'qq-render (appkit-projection-change-create :frame-p t))))
              (should (equal releases '("viewport-1")))
              (appkit-surface-send surface
                                   (list 'qq-render (appkit-projection-change-create :frame-p t)))
              (should (= starts 2))
              (appkit-surface-stop surface)
              (should (equal releases '("viewport-2" "viewport-1")))
              (should (= (hash-table-count qq-remote-media--lease-aliases) 0)))))))))



(ert-deftest qq-media-hidden-chat-releases-viewport-but-preserves-viewer-and-draft ()
  (qq-message-test-with-state
    (qq-remote-media-test-with-part-access
      (let* ((qq-remote-media--lease-aliases (make-hash-table :test #'equal))
             (qq-media--consumers (make-hash-table :test #'eq))
             (session "private:10001")
             (message `((id . "200") (server-id . "200") (session-key . ,session)
                        (sender-name . "Peer") (sender-id . "10001") (time . 1784800000)
                        (segments . (((type . "image")
                                      (data . ((media_id . ,qq-remote-media-test-id))))))))
             (other (generate-new-buffer " *qq-visibility-other*"))
             (viewer (generate-new-buffer " *qq-visibility-viewer*"))
             (viewer-ref (qq-resource-acquire-access "res-native-silk" #'ignore #'ert-fail))
             (starts 0) releases surface second)
        (funcall open-callback)
        (puthash "res-native-silk" viewer-ref
                 (plist-get (qq-media--owner-state viewer) :refs))
        (puthash session (list message) qq-state--messages-by-session)
        (unwind-protect
            (cl-letf (((symbol-function 'qq-rpc-method-available-p)
                       (lambda (method) (equal method "media.acquire")))
                      ((symbol-function 'qq-rpc-call)
                       (lambda (method params &rest options)
                         (pcase method
                           ("media.acquire"
                            (cl-incf starts)
                            (funcall (plist-get options :callback)
                                     `((lease . ((lease_id . ,(format "visible-%d" starts))
                                                 (expires_in . 120)))
                                       (media . ,(qq-remote-media-test-snapshot)))))
                           ("media.release_lease"
                            (push (alist-get 'lease_id params) releases)))
                         'lease-request))
                      ((symbol-function 'qq-media--fetch-native-image-part-resource) #'ignore)
                      ((symbol-function 'qq-chat--maybe-auto-load-older) #'ignore)
                      ((symbol-function 'qq-chat--maybe-auto-load-newer) #'ignore)
                      ((symbol-function 'qq-media--visible-row-keys)
                       (lambda (_)
                         (and (get-buffer-window-list (current-buffer) nil t) '("200")))))
              (save-window-excursion
                (with-temp-buffer
                  (qq-chat-mode)
                  (qq-runtime-bind-account "slot-a")
                  (setq qq-chat--session-key session)
                  (qq-chat--set-history-window "200" nil)
                  (switch-to-buffer (current-buffer))
                  (setq second (split-window-right))
                  (set-window-buffer second (current-buffer))
                  (qq-chat-render)
                  (setq surface (appkit-current-surface))
                  (qq-chat--set-draft "draft survives hiding")
                  (appkit-surface-send
                   surface (list 'qq-render (appkit-projection-change-create :full-p t)))
                  (should (= starts 1))
                  (cl-labels
                      ((redisplay-change ()
                         (run-hook-with-args 'window-state-change-functions (selected-frame))
                         (should (appkit-scroll-observer-deferred-check-handle
                                  qq-media--viewport-observer))
                         (appkit-scroll-observer--run-deferred-check qq-media--viewport-observer)))
                    (set-window-buffer (selected-window) other)
                    (redisplay-change)
                    (should-not releases)
                    (should (= starts 1))
                    (delete-window second)
                    (redisplay-change)
                    (should (equal releases '("visible-1")))
                    (should (qq-resource-access-live-p viewer-ref))
                    (should (gethash viewer qq-media--consumers))
                    (should (equal (qq-chat--current-draft-string) "draft survives hiding"))
                    (set-window-buffer (selected-window) (current-buffer))
                    (redisplay-change)
                    (should (= starts 2))
                    (should (equal releases '("visible-1")))
                    (should (equal (qq-chat--current-draft-string) "draft survives hiding")))
                  (appkit-surface-stop surface)
                  (should (equal releases '("visible-2" "visible-1")))
                  (should (qq-resource-access-live-p viewer-ref))
                  (should (buffer-live-p viewer)))))
          (when (buffer-live-p other) (kill-buffer other))
          (when (buffer-live-p viewer) (kill-buffer viewer)))
        (should-not (qq-resource-access-live-p viewer-ref))))))


(provide 'qq-media-lease-test)
