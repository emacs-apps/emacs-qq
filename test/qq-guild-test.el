(ert-deftest qq-guild-avatar-rejects-cross-account-and-tiny-responses ()
  (qq-guild-test-with-app
    (let (failure downloaded)
      (cl-letf (((symbol-function 'appkit-media-image-resource-load)
                 (lambda (&rest _) (setq downloaded t))))
        (qq-guild-avatar--load nil '(qq-guild-avatar "slot-a" "gateway-a" 1 "11" "22" nil)
                               #'ignore (lambda (reason) (setq failure reason)))
        (qq-operation-test--resolve
         (car calls)
         '((account_id . "slot-a")
           (profile . ((member . ((guild_id . "11") (tiny_id . "23")))
                       (avatar_url . "https://example.invalid/a"))))))
      (should failure)
      (should-not downloaded))))

(ert-deftest qq-guild-avatar-cancel-fences-profile-and-closes-image-acquisition ()
  (qq-guild-test-with-app
    (let (downloaded image-closed)
      (cl-letf (((symbol-function 'appkit-media-image-resource-load)
                 (lambda (&rest _) (setq downloaded t)
                   (appkit-cancellation-create :kind 'logical :cancel (lambda () (setq image-closed t))))))
        (let ((handle (qq-guild-avatar--load
                       nil '(qq-guild-avatar "slot-a" "gateway-a" 1 "11" "22" nil) #'ignore #'ignore)))
          (funcall (appkit-cancellation-cancel handle))
          (qq-operation-test--resolve
           (car calls)
           '((account_id . "slot-a")
             (profile . ((member . ((guild_id . "11") (tiny_id . "22")))
                         (avatar_url . "https://example.invalid/a")))))
          (should-not downloaded))
        (let ((handle (qq-guild-avatar--load
                       nil '(qq-guild-avatar "slot-a" "gateway-a" 1 "11" "22" "https://example.invalid/a")
                       #'ignore #'ignore)))
          (should downloaded)
          (funcall (appkit-cancellation-cancel handle))
          (should image-closed))))))

(require 'qq-guild-forum)
(require 'qq-guild-channel)

(defun qq-guild-test--post (id)
  (let ((identity `((channel . ,qq-guild-test--channel) (post_id . ,id) (author_tiny_id . "9007199254740997"))))
    `((identity . ,identity) (author . ((tiny_id . "9007199254740997") (name . "Alice")))
      (title . ,(concat "Topic " id)) (text . ,(concat "论坛正文 " id)) (timestamp . 1784000000)
      (comment_count . 2) (unsupported_elements . 0))))

(defun qq-guild-test--comment (id &optional replies count)
  `((comment_id . ,id) (author . ((tiny_id . "9007199254740999") (name . "Bob")))
    (text . ,(concat "Comment " id)) (timestamp . 1784000000)
    (reply_count . ,(or count 0)) (replies . ,replies) (unsupported_elements . 0)))

(defun qq-guild-test--forum-page (cursor next &rest posts)
  `((account_id . "slot-a") (page . ((channel . ,qq-guild-test--channel)
                                     (cursor . ,cursor) (next_cursor . ,next) (posts . ,posts)))))

(ert-deftest qq-guild-forum-pages-preserve-point-and-reject-misrouting ()
  (qq-guild-test-with-app
    (with-current-buffer (qq-guild-forum-open qq-guild-test--channel "Forum" "slot-a")
      (qq-operation-test--drain)
      (should (equal (plist-get (car calls) :method) "guild.forum"))
      (qq-operation-test--resolve (car calls)
                                  (qq-guild-test--forum-page "" "opaque:/next" (qq-guild-test--post "p1")))
      (qq-operation-test--drain)
      (should (string-match-p "论坛正文 p1" (buffer-string)))
      (goto-char (point-min)) (search-forward "论坛正文")
      (let ((position (point)))
        (qq-guild-forum-load-more)
        (qq-operation-test--drain)
        (should (equal (alist-get 'cursor (alist-get 'request (plist-get (car calls) :params))) "opaque:/next"))
        (qq-operation-test--resolve (car calls)
                                    (qq-guild-test--forum-page "opaque:/next" nil (qq-guild-test--post "p2")))
        (qq-operation-test--drain)
        (should (= position (point)))
        (should (string-match-p "论坛正文 p2" (buffer-string)))
        (let ((count (length calls)))
          (qq-guild-forum-load-more) (qq-operation-test--drain)
          (should (= count (length calls))))
        (qq-guild-forum-refresh) (qq-operation-test--drain)
        (let ((bad (copy-tree (qq-guild-test--forum-page "" nil (qq-guild-test--post "other")))))
          (setf (alist-get 'guild_id (alist-get 'channel (alist-get 'page bad))) "99")
          (qq-operation-test--resolve (car calls) bad))
        (qq-operation-test--drain)
        (should (string-match-p "论坛正文 p1" (buffer-string)))
        (should (plist-get (qq-guild-forum--model) :error))))))

(ert-deftest qq-guild-discussion-opens-comments-and-pages-replies-by-parent ()
  (qq-guild-test-with-app
    (let* ((post (qq-guild-test--post "p1"))
           (identity (alist-get 'identity post))
           (list-buffer (qq-guild-forum-open qq-guild-test--channel "Forum" "slot-a")))
      (with-current-buffer list-buffer
        (qq-operation-test--drain)
        (qq-operation-test--resolve (car calls) (qq-guild-test--forum-page "" nil post))
        (qq-operation-test--drain)
        (goto-char (point-min)) (search-forward "论坛正文 p1")
        (qq-guild-forum-open-at-point))
      (let* ((app (qq-runtime-app "slot-a"))
             (surface (appkit-app-surface app (cons 'guild-forum (qq-guild--operation-key 'comments identity)))))
