;;; qq-guild-test.el --- Guild App and Surface regressions -*- lexical-binding: t; -*-
(require 'ert)
(require 'qq-operation-test)
(require 'qq-guilds)
(require 'qq-guild-chat)

(defconst qq-guild-test--channel '((guild_id . "9007199254740993") (channel_id . "9007199254740995")))

(defun qq-guild-test--message (sequence &optional channel)
  `((channel . ,(or channel qq-guild-test--channel))
    (sequence . ,sequence) (count_sequence . ,sequence) (timestamp . 1784000000)
    (sender_tiny_id . "9007199254740997") (sender_name . "Alice")
    (text . ,(concat "message " sequence)) (unsupported_elements . 0)))

(defun qq-guild-test--history (call begin end &rest messages)
  (qq-operation-test--resolve
   call `((account_id . "slot-a")
          (history . ((channel . ,qq-guild-test--channel)
                      (begin_sequence . ,begin) (end_sequence . ,end)
                      (unsupported_messages . 0) (messages . ,messages))))))

(defun qq-guild-test--state (&optional owner)
  (qq-state-partition-guild (appkit-app-model (qq-runtime-app (or owner "slot-a")))))

(defmacro qq-guild-test-with-app (&rest body)
  (declare (indent 0))
  `(qq-operation-test-with-app
    (let ((appkit-debug t) (appkit-strict-boundaries t))
      (cl-letf (((symbol-function 'qq-rpc-method-available-p) (lambda (_) t)))
        ,@body))))

(defun qq-guild-test--open ()
  (qq-guild-chat-open qq-guild-test--channel "Guild · #text" "slot-a"))

(ert-deftest qq-guild-history-sparse-pages-use-returned-boundary ()
  (qq-guild-test-with-app
    (with-current-buffer (qq-guild-test--open)
      (qq-operation-test--drain)
      (let ((call (car calls)))
        (should (equal (plist-get call :method) "guild.history"))
        (qq-guild-test--history call "51" "100" (qq-guild-test--message "99")))
      (qq-operation-test--drain)
      (should (equal (appkit-chat-timeline-keys) '("99")))
      (qq-guild-history-older)
      (qq-operation-test--drain)
      (should (equal (alist-get 'end_sequence (plist-get (car calls) :params)) "50"))
      (qq-guild-test--history (car calls) "1" "50")
      (qq-operation-test--drain)
      (should (equal (plist-get (qq-guild-chat--model) :begin) "1"))
      (should (equal (appkit-chat-timeline-keys) '("99")))
      (should (appkit-surface-live-p (appkit-current-surface))))))

(ert-deftest qq-guild-push-is-canonical-account-scoped-and-idempotent ()
  (qq-guild-test-with-app
    (let* ((app (qq-runtime-app "slot-a"))
           (before (appkit-app-model app))
           (data `((account_id . "slot-a") (messages . (,(qq-guild-test--message "10"))) (channels . nil))))
      (qq-guild--event "guild.observed" data)
      (qq-guild--event "guild.observed" data)
      (should-not (qq-state-partition-guild before))
      (should (= 1 (length (qq-guild--get (qq-guild-test--state) :messages (qq-guild--key qq-guild-test--channel)))))
      (should-not (qq-guild--get (qq-guild-test--state "slot-b") :messages (qq-guild--key qq-guild-test--channel)))
      (should-not calls))))

(ert-deftest qq-guild-directory-lazy-fold-filter-and-stable-nodes ()
  (qq-guild-test-with-app
    (with-current-buffer (qq-guilds-open)
      (qq-operation-test--drain)
      (qq-operation-test--resolve
       (car calls) '((account_id . "slot-a")
                     (guilds . (((guild_id . "9007199254740993") (name . "Guild"))))))
      (qq-operation-test--drain)
      (let* ((key '(guild "9007199254740993"))
             (node (gethash key (appkit-directory-surface-node-table (appkit-directory-surface)))))
        (should node)
        (should (= 1 (length calls)))
        (puthash key t (appkit-directory-surface-fold-state (appkit-directory-surface)))
        (appkit-surface-send (appkit-current-surface) '(expand "9007199254740993" t))
        (qq-operation-test--drain)
        (should (equal (plist-get (car calls) :method) "guild.channels"))
        (qq-operation-test--resolve
         (car calls)
         `((account_id . "slot-a")
           (list . ((guild_id . "9007199254740993") (self_tiny_id . "100")
                    (channels . (((channel . ,qq-guild-test--channel) (name . "text") (channel_type . 1) (state . nil))))))))
        (qq-operation-test--drain)
        (should (eq node (gethash key (appkit-directory-surface-node-table (appkit-directory-surface)))))
        (should (gethash '(channel "9007199254740993" "9007199254740995")
                         (appkit-directory-surface-node-table (appkit-directory-surface))))
        (qq-guilds-filter "no match")
        (should-not (gethash key (appkit-directory-surface-node-table (appkit-directory-surface))))
        (qq-guilds-clear-filter)
        (should (gethash key (appkit-directory-surface-fold-state (appkit-directory-surface))))
        (should (= 2 (length calls)))))))

(ert-deftest qq-guild-push-and-refresh-preserve-inline-draft-point-and-row ()
  (qq-guild-test-with-app
    (with-current-buffer (qq-guild-test--open)
      (qq-operation-test--drain)
      (qq-guild-test--history (car calls) "1" "10" (qq-guild-test--message "10"))
      (qq-operation-test--drain)
      (appkit-chatbuf-input-set-text "draft\nsecond line")
      (goto-char (+ (appkit-chatbuf-input-start-position) 3))
      (let ((offset (- (point) (appkit-chatbuf-input-start-position)))
            (node (appkit-chat-timeline-node "10")))
        (qq-guild--event "guild.observed"
                         `((account_id . "slot-a") (messages . (,(qq-guild-test--message "11"))) (channels . nil)))
        (qq-operation-test--drain)
        (should (equal (appkit-chatbuf-input-string) "draft\nsecond line"))
        (should (= offset (- (point) (appkit-chatbuf-input-start-position))))
        (should (eq node (appkit-chat-timeline-node "10")))
        (should (equal (appkit-chat-timeline-keys) '("10" "11")))
        (should (get-text-property (point-min) 'read-only))
        (should-not (get-text-property (point) 'read-only))))))

(ert-deftest qq-guild-send-keeps-later-edits-and-clears-only-confirmed-capture ()
  (qq-guild-test-with-app
    (with-current-buffer (qq-guild-test--open)
      (qq-operation-test--drain)
      (qq-guild-test--history (car calls) "0" "0")
      (qq-operation-test--drain)
      (appkit-chatbuf-input-set-text "first")
      (qq-guild-send)
      (qq-operation-test--drain)
      (should-error (qq-guild-send)
                    :type 'user-error)
      (let ((send (car calls)))
        (appkit-chatbuf-input-set-text "next draft")
        (qq-operation-test--resolve send `((account_id . "slot-a") (receipt . ((channel . ,qq-guild-test--channel) (sequence . "1"))))))
      (qq-operation-test--drain)
      (should (equal (appkit-chatbuf-input-string) "next draft"))
      (qq-guild-test--history (car calls) "1" "1" (qq-guild-test--message "1"))
      (qq-operation-test--drain)
      (qq-guild-send)
      (qq-operation-test--drain)
      (qq-operation-test--resolve (car calls) `((account_id . "slot-a") (receipt . ((channel . ,qq-guild-test--channel) (sequence . "2")))))
      (qq-operation-test--drain)
      (should (equal (appkit-chatbuf-input-string) ""))
      (should (equal (plist-get (car calls) :method) "guild.history")))))

(ert-deftest qq-guild-send-failure-retains-draft-without-automatic-retry ()
  (qq-guild-test-with-app
    (with-current-buffer (qq-guild-test--open)
      (qq-operation-test--drain)
      (qq-guild-test--history (car calls) "0" "0")
      (qq-operation-test--drain)
      (appkit-chatbuf-input-set-text "keep me")
      (qq-guild-send)
      (qq-operation-test--drain)
      (funcall (plist-get (plist-get (car calls) :options) :errback) nil "timeout")
      (qq-operation-test--drain)
      (should (equal (appkit-chatbuf-input-string) "keep me"))
      (should (string-match-p "timeout" (plist-get (qq-guild-chat--model) :notice)))
      (should (= 2 (length calls))))))

(ert-deftest qq-guild-replaced-surface-rejects-old-history-and-preserves-account-cache ()
  (qq-guild-test-with-app
    (let ((old-buffer (qq-guild-test--open)))
      (qq-operation-test--drain)
      (let ((old-call (car calls)))
        (kill-buffer old-buffer)
        (with-current-buffer (qq-guild-test--open)
          (qq-operation-test--drain)
          (should (memq (plist-get old-call :token) cancelled))
          (qq-guild-test--history old-call "1" "10" (qq-guild-test--message "10"))
          (qq-guild-test--history (car calls) "51" "100" (qq-guild-test--message "100"))
          (qq-operation-test--drain)
          (should (equal (appkit-chat-timeline-keys) '("100")))
          (should (equal (plist-get (qq-guild-chat--model) :begin) "51")))))))

(ert-deftest qq-guild-read-is-confirmed-and-never-uses-ordinary-chat-routing ()
  (qq-guild-test-with-app
    (with-current-buffer (qq-guild-test--open)
      (qq-operation-test--drain)
      (qq-guild-test--history (car calls) "1" "10" (qq-guild-test--message "10"))
      (qq-operation-test--drain)
      (appkit-chatbuf-focus-input)
      (qq-guild-mark-read)
      (qq-operation-test--drain)
      (should-not (qq-guild-chat--read-sequence (qq-guild-test--state) qq-guild-test--channel))
      (let ((params (plist-get (car calls) :params)))
        (should (equal (alist-get 'channel params) qq-guild-test--channel))
        (should (equal (alist-get 'sequence params) "10"))
        (should-not (assq 'conversation params)))
      (qq-operation-test--resolve (car calls) `((account_id . "slot-a") (receipt . ((channel . ,qq-guild-test--channel) (sequence . "10")))))
      (qq-operation-test--drain)
      (should (equal (qq-guild-chat--read-sequence (qq-guild-test--state) qq-guild-test--channel) "10")))))

(ert-deftest qq-guild-history-misrouting-never-enters-canonical-state ()
  (qq-guild-test-with-app
    (with-current-buffer (qq-guild-test--open)
      (qq-operation-test--drain)
      (qq-guild-test--history (car calls) "1" "10"
                              (qq-guild-test--message "10" '((guild_id . "42") (channel_id . "43"))))
      (qq-operation-test--drain)
      (should-not (qq-guild--get (qq-guild-test--state) :messages (qq-guild--key qq-guild-test--channel)))
      (should (plist-get (qq-guild-chat--model) :notice))
      (should (appkit-surface-live-p (appkit-current-surface))))))

(ert-deftest qq-guild-session-reset-fences-old-work-and-retains-unknown-send ()
  (qq-guild-test-with-app
    (with-current-buffer (qq-guild-test--open)
      (qq-operation-test--drain)
      (qq-guild-test--history (car calls) "0" "0")
      (qq-operation-test--drain)
      (appkit-chatbuf-input-set-text "in flight")
      (qq-guild-send)
      (qq-operation-test--drain)
      (let ((old (car calls)) (app (qq-runtime-app "slot-a")))
        (appkit-app-send app '(qq-guild-reset "offline" "gateway-a"))
        (qq-operation-test--drain)
        (should (memq (plist-get old :token) cancelled))
        (appkit-app-send app '(qq-guild-reset "online" "gateway-b"))
        (qq-operation-test--drain)
        (qq-operation-test--resolve
         old `((account_id . "slot-a") (receipt . ((channel . ,qq-guild-test--channel) (sequence . "1")))))
        (qq-guild-test--history (car calls) "0" "0")
        (qq-operation-test--drain)
        (should (equal (appkit-chatbuf-input-string) "in flight"))
        (should (plist-get
                 (qq-guild--get (qq-guild-test--state) :operations
                                (qq-guild--operation-key 'send qq-guild-test--channel))
                 :unknown))
        (should (string-match-p "发送结果未知" (buffer-string)))
        (should (= 1 (cl-count "guild.send_text" calls :key (lambda (call) (plist-get call :method)) :test #'equal)))))))

(ert-deftest qq-guild-recovery-retains-draft-positions-and-scroll-observer ()
  (qq-guild-test-with-app
    (with-current-buffer (qq-guild-test--open)
      (qq-operation-test--drain)
      (qq-guild-test--history (car calls) "1" "10" (qq-guild-test--message "10"))
      (qq-operation-test--drain)
      (appkit-chatbuf-input-set-text "draft survives recovery")
      (goto-char (+ 3 (appkit-chatbuf-input-start-position)))
      (let ((original (symbol-function 'qq-guild-chat--print))
            (observer qq-guild-chat--observer) failed)
        (cl-letf (((symbol-function 'qq-guild-chat--print)
                   (lambda (row)
                     (if failed (funcall original row)
                       (setq failed t) (error "synthetic render failure")))))
          (qq-guild--event
           "guild.observed"
           `((account_id . "slot-a") (channels . nil) (messages . (,(qq-guild-test--message "11")))))
          (qq-operation-test--drain))
        (should failed)
        (should (appkit-surface-live-p (appkit-current-surface)))
        (should (equal (appkit-chat-timeline-keys) '("10" "11")))
        (should (equal (appkit-chatbuf-input-string) "draft survives recovery"))
        (should (= 3 (- (point) (appkit-chatbuf-input-start-position))))
        (should (eq observer qq-guild-chat--observer))
        (should (appkit-scroll-observer-active-p observer))))))

(ert-deftest qq-guild-return-on-timeline-never-sends-or-enters-composer ()
  (qq-guild-test-with-app
    (with-current-buffer (qq-guild-test--open)
      (qq-operation-test--drain)
      (qq-guild-test--history (car calls) "1" "10" (qq-guild-test--message "10"))
      (qq-operation-test--drain)
      (appkit-chatbuf-input-set-text "not sent")
      (goto-char (appkit-chat-timeline-key-position "10"))
      (let ((point (point)) (requests (length calls)))
        (qq-guild-chat-return)
        (should (= point (point)))
        (should (= requests (length calls)))
        (should (equal (appkit-chatbuf-input-string) "not sent"))))))

(ert-deftest qq-guild-directory-error-keeps-last-snapshot ()
  (qq-guild-test-with-app
    (with-current-buffer (qq-guilds-open)
      (qq-operation-test--drain)
      (qq-operation-test--resolve
       (car calls) '((account_id . "slot-a") (guilds . (((guild_id . "42") (name . "Retained"))))))
      (qq-operation-test--drain)
      (qq-guilds-refresh t)
      (qq-operation-test--drain)
      (funcall (plist-get (plist-get (car calls) :options) :errback) nil "offline")
      (qq-operation-test--drain)
      (should (string-match-p "Retained" (buffer-string)))
      (should (string-match-p "offline" (buffer-string))))))

(ert-deftest qq-guild-read-cursors-never-regress-on-stale-directory-snapshots ()
  (let* ((channel qq-guild-test--channel)
         (state `((channel . ,channel) (name . "text") (channel_type . 1)
                  (latest_sequence . "100") (latest_count_sequence . "80")
                  (read_sequence . "90") (read_count_sequence . "70")))
         (new (qq-guild--merge-state nil state))
         (old (copy-tree state)))
    (setf (alist-get 'latest_sequence old) "80" (alist-get 'latest_count_sequence old) "60"
          (alist-get 'read_sequence old) "70" (alist-get 'read_count_sequence old) "50")
    (should (equal (qq-guild--get (qq-guild--merge-state new old) :states (qq-guild--key channel)) state))
    (should (equal (qq-guild--get new :states (qq-guild--key channel)) state))))

(ert-deftest qq-guild-observations-before-first-open-survive-session-initialization ()
  (qq-guild-test-with-app
    (qq-runtime-app "slot-a")
    (qq-guild--event "guild.observed"
                     `((account_id . "slot-a") (channels . nil)
                       (messages . (,(qq-guild-test--message "10")))))
    (with-current-buffer (qq-guild-test--open)
      (qq-operation-test--drain)
      (should (= 1 (length (qq-guild--get (qq-guild-test--state) :messages
                                          (qq-guild--key qq-guild-test--channel))))))))

(ert-deftest qq-guild-resync-revokes-work-even-when-account-phase-is-unchanged ()
  (qq-guild-test-with-app
    (with-current-buffer (qq-guild-test--open)
      (qq-operation-test--drain)
      (let ((old (car calls)))
        (qq-guild--account-changed 'resync "slot-a")
        (qq-operation-test--drain)
        (should (memq (plist-get old :token) cancelled))
        (should (= 2 (length calls)))
        (qq-guild-test--history old "1" "10" (qq-guild-test--message "10"))
        (qq-guild-test--history (car calls) "11" "20" (qq-guild-test--message "20"))
        (qq-operation-test--drain)
        (should (equal (appkit-chat-timeline-keys) '("20")))))))

(ert-deftest qq-guild-shared-bindings-keep-return-variants-and-native-evil-actions ()
  (require 'qq-evil)
  (qq-evil-setup)
  (should (eq (keymap-lookup qq-guild-chat-mode-map "RET") #'qq-guild-chat-return))
  (should (eq (keymap-lookup qq-guild-chat-mode-map "<return>") #'qq-guild-chat-return))
  (should (eq (keymap-lookup qq-guild-chat-mode-map "C-c C-c") #'qq-guild-send))
  (when (featurep 'evil)
    (should (eq (lookup-key (evil-get-auxiliary-keymap qq-guild-chat-timeline-mode-map 'normal t)
                            (kbd "g +"))
                #'qq-guild-history-older))))

