;;; qq-state-test.el --- Immutable account state tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'qq-test-state)

(ert-deftest qq-state-indexes-preserve-snapshots-and-local-send-order ()
  (let* ((session "private:10001")
         (state (qq-state-store-create :account-id "slot-a"))
         (first `((id . "local:1") (local-id . "local:1") (status . pending)
                  (session-key . ,session) (time . 10) (order . 1)
                  (message-seq . "7") (preview . "first")))
         (second (qq-state--merge-alists first '((id . "local:2") (local-id . "local:2")
                                                 (order . 2)))))
    (appkit-data-step state (qq-state--put-message state session first))
    (appkit-data-step state (qq-state--put-message state session second))
    (let* ((before state)
           (updated (qq-state--merge-alists first '((preview . "enriched")))))
      (appkit-data-step state (qq-state--put-message state session updated first))
      (should (equal (qq-state-history-pending (qq-state--history state session)) '("local:1" "local:2")))
      (should (= (length (qq-state-message-candidates state session 'message-seq "7")) 2))
      (should (equal (alist-get 'preview (qq-state-session-message before session "local:1")) "first"))
      (let ((unchanged state))
        (appkit-data-step state (qq-state--put-message state session (copy-tree updated) updated))
        (should (eq state unchanged)))
      (setq first updated)
      (setq updated (qq-state--merge-alists first '((id . "100") (server-id . "100")
                                                    (status . sent) (canonical-row-key . "42"))))
      (appkit-data-step state (qq-state--put-message state session updated first))
      (should (equal (qq-state-session-message state session "local:1")
                     (qq-state-session-message state session "100")))
      (should (equal (qq-state-history-pending (qq-state--history state session)) '("local:2")))
      (should (= (length (qq-state-session-outgoing-messages state session)) 2))
      (appkit-data-step state (qq-state-acknowledge-window state session (list updated)))
      (setq first updated updated (qq-state--merge-alists updated '((preview . "confirmed"))))
      (appkit-data-step state (qq-state--put-message state session updated first))
      (should (equal (mapcar #'qq-state-message-anchor (qq-state-session-outgoing-messages state session))
                     '("local:2")))
      (should (= (length (qq-state-message-candidates before session 'message-seq "7")) 2))
      (let ((owned (qq-state-session-message state session "100")))
        (setf (alist-get 'preview owned) "caller mutation")
        (should (equal (alist-get 'preview (qq-state-session-message state session "100")) "confirmed"))))))

(ert-deftest qq-runtime-reducer-failure-publishes-neither-data-nor-notifications ()
  (qq-test-with-state (qq-state-store-create :account-id "slot-a")
    (qq-runtime-app)
    (let* ((before (qq-runtime-state)) events
           (qq-runtime-change-hook (list (lambda (event) (push event events)))))
      (should-error
       (qq-runtime-transact
        (lambda (state)
          (appkit-data-step state (qq-state-set-self-info state '((user_id . "10001"))))
          (error "projection failed"))))
      (qq-test-drain)
      (should (eq before (qq-runtime-state)))
      (should-not events))))

(ert-deftest qq-state-changes-preserve-read-and-directory-projections ()
  (let* ((before (qq-state-store-create :account-id "slot-a"))
         (after (car (qq-state-upsert-session before "group:42" '((unread-message-count . 0))))))
    (setq after (appkit-data-with after
                  ((:friends-by-id) "10001" '((user_id . "10001") (nickname . "renamed")))))
    (let* ((events (qq-state-changes before after 'response))
           (read (seq-find (lambda (event) (eq (plist-get event :type) 'session)) events)))
      (should (eq (plist-get read :mutation) 'read))
      (should (seq-some (lambda (event) (eq (plist-get event :type) 'friends-refreshed)) events))
      (should (seq-every-p (lambda (event) (and (eq (plist-get event :state) after)
                                               (equal (plist-get event :account-id) "slot-a")))
                          events))
      (should-not (qq-state-changes after after 'response)))))

(provide 'qq-state-test)
;;; qq-state-test.el ends here
