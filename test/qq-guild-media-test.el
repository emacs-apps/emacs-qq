;;; qq-guild-media-test.el --- Forum content and resource boundaries -*- lexical-binding: t; -*-
(require 'qq-guild-test)
(require 'qq-guild-media)

(defun qq-guild-media-test--post ()
  "A post with a full image distinct from its thumbnail and ordered rich text."
  (let ((post (qq-guild-test--post "media")))
    (setf (alist-get 'content post)
          '(((kind . "text") (text . "正文"))
            ((kind . "emoji") (id . "9") (name . "大哭")
             (url . "https://framework.cdn-go.cn/qqmoji/latest/sysface/static/s9.png"))
            ((kind . "link") (text . "链接") (url . "https://pd.qq.com/example")))
          (alist-get 'media post)
          '(((kind . "image") (id . "picture") (url . "https://channel.qpic.cn/original")
             (preview_url . "https://channel.qpic.cn/thumbnail")
             (width . 800) (height . 600) (duration . 0))))
    post))

(ert-deftest qq-guild-media-validates-rich-content-and-keeps-legacy-pages ()
  (should (qq-guild--forum-body-p (qq-guild-test--post "old")))
  (should (qq-guild--forum-body-p (qq-guild-media-test--post)))
  (dolist (url '("file:///tmp/private" "javascript:alert(1)"
                "https://user:secret@example.com/image" "http://channel.qpic.cn/image"))
    (let ((post (copy-tree (qq-guild-media-test--post))))
      (setf (alist-get 'url (car (alist-get 'media post))) url)
      (should-not (qq-guild--forum-body-p post))))
  (let ((post (copy-tree (qq-guild-media-test--post))))
    (setf (alist-get 'kind (car (alist-get 'content post))) "unknown")
    (should-not (qq-guild--forum-body-p post))))

(ert-deftest qq-guild-media-renders-body-order-and-full-image-action ()
  (qq-guild-test-with-app
    (with-current-buffer (qq-guild-forum-open qq-guild-test--channel "Media" "slot-a")
      (qq-operation-test--drain)
      (qq-operation-test--resolve (car calls)
                                  (qq-guild-test--forum-page "" nil (qq-guild-media-test--post)))
      (qq-operation-test--drain)
      (should (string-match-p "正文\\[大哭\\]链接" (buffer-string)))
      (should-not (string-match-p "Topic media\\|暂未支持" (buffer-string)))
      (should (string-match-p "\\[图片\\]" (buffer-string)))
      (let* ((surface (appkit-current-surface))
             (entry (car (alist-get 'media (qq-guild-media-test--post))))
             (spec (list :media entry :key '(picture)))
             (cell (qq-guild-media--cell surface spec 160 t))
             opened)
        (cl-letf (((symbol-function 'qq-media-open-resource)
                   (lambda (resource kind key &rest options)
                     (setq opened (list resource kind key options)))))
          (funcall (appkit-media-grid-cell-action cell)))
        (should (equal (alist-get 'url (car opened)) "https://channel.qpic.cn/original"))
        (should (eq (cadr opened) 'image))
        (should (eq (plist-get (nth 3 opened) :owner) surface))))))

(ert-deftest qq-guild-media-renders-image-comments-and-replies ()
  (qq-guild-test-with-app
    (let* ((post (qq-guild-media-test--post))
           (reply (cons (cons 'media (copy-tree (alist-get 'media post)))
                        (qq-guild-test--comment "r1")))
           (comment (cons (cons 'media (copy-tree (alist-get 'media post)))
                          (qq-guild-test--comment "c1" (list reply) 1)))
           downloads)
      (setf (alist-get 'text comment) "")
      (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
                ((symbol-function 'qq-guild-avatar--load)
                 (lambda (_context _input resolve _reject) (funcall resolve nil) nil))
                ((symbol-function 'qq-guild-avatar-image) (lambda (_) nil))
                ((symbol-function 'appkit-media-image-resource-load)
                 (lambda (_context input _resolve _reject)
                   (push input downloads)
                   (appkit-cancellation-create :cancel #'ignore))))
        (with-current-buffer
            (qq-guild-forum--open 'comments (alist-get 'identity post) "图片评论" "slot-a")
          (qq-operation-test--drain)
          (should (equal (plist-get (car calls) :method) "guild.comments"))
          (qq-operation-test--resolve
           (car calls)
           `((account_id . "slot-a")
             (page . ((post . ,(alist-get 'identity post)) (cursor . "")
                      (next_cursor . nil) (total_count . 1)
                      (comments . (,comment))))))
          (qq-operation-test--drain)
          (should (= (length downloads) 2))
          (should (= (how-many "\\[图片" (point-min) (point-max)) 2))
          (should (string-match-p "Comment r1" (buffer-string))))))))

(ert-deftest qq-guild-media-demands-are-account-and-session-owned ()
  (let* ((item (list :key '(post "media") :body-visible-p t
                     :value (qq-guild-media-test--post)))
         (one (qq-guild-media-plan '(:epoch 1) '(:account "a") item))
         (two (qq-guild-media-plan '(:epoch 1) '(:account "b") item))
         (new (qq-guild-media-plan '(:epoch 2) '(:account "a") item))
         (key (plist-get (car (plist-get one :media)) :key)))
    (should-not (equal key (plist-get (car (plist-get two :media)) :key)))
    (should-not (equal key (plist-get (car (plist-get new :media)) :key)))
    (should-not (qq-guild-media-plan '(:epoch 1) '(:account "a")
                                    (plist-put (copy-sequence item) :body-visible-p nil)))
    (let* ((spec (car (plist-get one :media)))
           (demand (qq-guild-media-demand spec))
           (input (appkit-resource-demand-input demand)))
      (should (equal (alist-get 'url (appkit-media-image-acquisition-resource (plist-get input :preview)))
                     "https://channel.qpic.cn/thumbnail")))))

(ert-deftest qq-guild-media-broker-releases-folded-body-and-ignores-late-images ()
  (qq-guild-test-with-app
    (let (downloads cancellations)
      (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
                ((symbol-function 'qq-guild-avatar--load)
                 (lambda (_context _input resolve _reject) (funcall resolve nil) nil))
                ((symbol-function 'qq-guild-avatar-image) (lambda (_) nil))
                ((symbol-function 'appkit-media-image-resource-load)
                 (lambda (_context input resolve _reject)
                   (push (cons input resolve) downloads)
                   (appkit-cancellation-create
                    :kind 'transport :cancel (lambda () (push input cancellations))))))
        (with-current-buffer (qq-guild-forum-open qq-guild-test--channel "Media" "slot-a")
          (qq-operation-test--drain)
          (qq-operation-test--resolve (car calls)
                                      (qq-guild-test--forum-page "" nil (qq-guild-media-test--post)))
          (qq-operation-test--drain)
          (should (= 2 (length downloads)))
          (goto-char (point-min)) (search-forward "正文")
          (qq-guild-forum-toggle-body) (qq-operation-test--drain)
          (should (= 2 (length cancellations)))
          (should (string-match-p "正文已折叠" (buffer-string)))
          (dolist (download downloads)
            (funcall (cdr download) "/tmp/retired-guild-media.png"))
          (qq-operation-test--drain)
          (should (string-match-p "正文已折叠" (buffer-string)))
          (should-not (string-match-p "图片" (buffer-string)))
          (should (= 2 (length downloads))))))))

(ert-deftest qq-guild-media-falls-back-from-avif-with-cancellable-original ()
  (let (original-callback settled cancelled (starts 0))
    (cl-letf (((symbol-function 'image-type-from-file-header)
               (lambda (file) (and (equal file "original.jpg") 'jpeg)))
              ((symbol-function 'appkit-media-image-resource-load)
               (lambda (_context input resolve _reject)
                 (cl-incf starts)
                 (if (eq input 'thumbnail)
                     (progn (funcall resolve "thumbnail.avif") nil)
                   (setq original-callback resolve)
                   (appkit-cancellation-create
                    :kind 'transport :cancel (lambda () (setq cancelled t)))))))
      (let ((operation
             (qq-guild-media--load nil '(:preview thumbnail :original original)
                                   (lambda (file) (setq settled file))
                                   (lambda (_) (ert-fail "Unexpected rejection")))))
        (should (= starts 2))
        (funcall (appkit-cancellation-cancel operation))
        (should cancelled)
        (funcall original-callback "original.jpg")
        (should-not settled)))))

(ert-deftest qq-guild-media-original-fallback-resolves-only-renderable-bytes ()
  (let (resolved (starts 0))
    (cl-letf (((symbol-function 'image-type-from-file-header)
               (lambda (file) (and (eq file 'original) 'jpeg)))
              ((symbol-function 'appkit-media-image-resource-load)
               (lambda (_context input resolve _reject)
                 (cl-incf starts) (funcall resolve input) nil)))
      (qq-guild-media--load nil '(:preview thumbnail :original original)
                            (lambda (file) (setq resolved file))
                            (lambda (_) (ert-fail "Unexpected rejection")))
      (should (= starts 2))
      (should (eq resolved 'original)))))

(provide 'qq-guild-media-test)
