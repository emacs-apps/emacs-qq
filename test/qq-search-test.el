;;; qq-search-test.el --- Chat-record search tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'qq-search)

(defun qq-search-test-account ()
  '((account_id . "slot-a") (uin . "10002") (uid . "u_self") (phase . "online")))

(defun qq-search-test-item (&optional row group)
  "Build a saved ROW, optionally a GROUP row without a Message ID."
  `((conversation . ,(if group
                         '((kind . "group") (group_uin . "20001"))
                       '((kind . "private") (peer_uin . "10001"))))
    (kind . "native") (row_key . ,(or row "17"))
    (timeline_class . "authored") (recalled . :false)
    (message
     . ((message_id . ,(unless group "7348923749823749823"))
        (sent_at . 1784700000)
        (sender . ((uin . "10001") (uid . "u_peer")))
        (recipient . ((uin . "10002") (uid . "u_self")))
        (conversation . ,(if group
                             '((kind . "group") (group_uin . "20001"))
                           '((kind . "private"))))
        (sequence . "9007199254740999")
        (segments . [((kind . "text") (payload . ((text . "中文 [a.*] QQ é É"))))])))))

(defun qq-search-test-page (&optional rows cursor query)
  `((account_id . "slot-a") (gateway_instance_id . "gateway-a")
    (query . ,(or query "中文")) (scope . "local")
    (messages . ,(vconcat (or rows (list (qq-search-test-item)))))
    (next_cursor . ,cursor)))

(defmacro qq-search-test-with-ui (&rest body)
  "Run BODY with a real Appkit result Surface and a fake transport."
  (declare (indent 0) (debug t))
  `(with-temp-buffer
     (qq-search-mode)
     (let* ((buffer (current-buffer))
            (qq-runtime--app nil)
            (qq-runtime--accounts (make-hash-table :test #'equal))
            (qq-state--partitions (make-hash-table :test #'equal))
            (qq-state--active-account-id nil)
            (qq-request--active (make-hash-table :test #'eq))
            (instance "gateway-a")
            (calls nil)
            (cancelled nil)
            (prints (make-hash-table :test #'equal))
            (projection nil)
            (projection-create (symbol-function 'appkit-projection-create))
            (row-printer (symbol-function 'qq-search--print-row))
            view)
       (cl-letf (((symbol-function 'qq-account-get)
                  (lambda (owner)
                    (and (equal owner "slot-a") (qq-search-test-account))))
                 ((symbol-function 'qq-server-gateway-instance-id)
                  (lambda () instance))
                 ((symbol-function 'qq-server-ready-p) (lambda () t))
                 ((symbol-function 'qq-server-capabilities)
                  (lambda () '("message.search")))
                 ((symbol-function 'appkit-projection-create)
                  (lambda (&rest arguments)
                    (setq projection (apply projection-create arguments))))
                 ((symbol-function 'qq-search--print-row)
                  (lambda (surface app-view row)
                    (let ((key (appkit-projection-row-key row)))
                      (puthash key (1+ (gethash key prints 0)) prints))
                    (funcall row-printer surface app-view row)))
                 ((symbol-function 'qq-server-cancel)
                  (lambda (token) (push token cancelled)))
                 ((symbol-function 'qq-server-send)
                  (lambda (method params success failure &optional _early)
                    (let ((token (format "search-%d" (1+ (length calls)))))
                      (setq calls (append calls (list (list :method method :params params
                                                            :success success :failure failure
                                                            :token token))))
                      token))))
         (unwind-protect
             (progn
               (qq-runtime-with-account "slot-a"
                 (qq-state-set-self-info '((user_id . "10002"))))
               (setq view
                     (qq-runtime-open-account-surface
                      :account-id "slot-a" :id '(search nil)
                      :mode 'qq-search-mode :buffer buffer
                      :renderer-factory #'qq-search--renderer-create
                      :setup
                      (lambda (surface)
                        (setq qq-search--account-id "slot-a"
                              qq-search--instance-id instance
                              qq-search--view surface
                              qq-search--query "中文"))))
               ,@body)
           (qq-runtime-stop))))))

(ert-deftest qq-search-normalizes-detached-rows-and-missing-sender-name ()
  (let ((qq-state--self-info '((user_id . "10002"))))
    (cl-letf (((symbol-function 'qq-account-get)
               (lambda (_owner) (qq-search-test-account))))
      (let* ((wire (qq-search-test-page (list (qq-search-test-item "17" t))))
             (page (qq-server-wire-domain-copy wire))
             (result (qq-search--check-page page "slot-a" "中文" nil nil "gateway-a"))
             (hit (car (plist-get result :hits)))
             (message (plist-get hit :message)))
        (should (equal (plist-get hit :center) '((kind . "row") (row_key . "17"))))
        (should (equal (plist-get hit :session-key) (qq-state-session-key 'group "20001")))
        (should-not (alist-get 'server-id message))
        (should (equal (alist-get 'sender-name message) "10001"))
        (should (equal (alist-get 'preview message) "中文 [a.*] QQ é É"))
        (should-not (alist-get 'sender_presentation
                               (alist-get 'message (car (alist-get 'messages page)))))))))

(ert-deftest qq-search-rejects-cross-account-instance-and-conversation-pages ()
  (let ((qq-state--self-info '((user_id . "10002"))))
    (cl-letf (((symbol-function 'qq-account-get)
               (lambda (_owner) (qq-search-test-account))))
      (let ((page (qq-server-wire-domain-copy (qq-search-test-page))))
        (should-error (qq-search--check-page page "slot-b" "中文" nil nil "gateway-a"))
        (should-error (qq-search--check-page page "slot-a" "中文" nil nil "gateway-b"))
        (should-error (qq-search--check-page page "slot-a" "other" nil nil "gateway-a"))
        (should-error
         (qq-search--check-page page "slot-a" "中文"
                                (qq-state-session-key 'group "20001") nil "gateway-a"))))))

(ert-deftest qq-search-literal-unicode-keywords-and-byte-limit ()
  (should (equal (qq-search--validate-query "  中文 [a.*]  ") "中文 [a.*]"))
  (should-error (qq-search--validate-query " \n\t")
                :type 'user-error)
  (should-error (qq-search--validate-query (make-string 342 ?中))
                :type 'user-error)
  (with-temp-buffer
    (let ((qq-search--query "[a.*]"))
      (qq-search--insert-preview "中文 [a.*] aZZ\nQQ")
      (should (equal (buffer-string) "中文 [a.*] aZZ\nQQ"))
      (should (memq 'match (ensure-list (get-text-property 4 'face))))
      (should-not (get-text-property 10 'face))))
  (with-temp-buffer
    (let ((qq-search--query "é"))
      (qq-search--insert-preview "é É")
      (should (get-text-property 1 'face))
      (should-not (get-text-property 3 'face))))
  (with-temp-buffer
    (let ((qq-search--query "qq"))
      (qq-search--insert-preview "QQ")
      (should (get-text-property 1 'face)))))

(ert-deftest qq-search-new-query-owns-late-results ()
  (qq-search-test-with-ui
    (qq-search-refresh)
    (let ((old (car calls)))
      (setq qq-search--query "[a.*]")
      (qq-search-refresh)
      (should (equal cancelled '("search-1")))
      (funcall (plist-get (cadr calls) :success)
               (qq-search-test-page nil nil "[a.*]"))
      (funcall (plist-get old :success) (qq-search-test-page))
      (should (equal qq-search--query "[a.*]"))
      (should (= (length qq-search--hits) 1))
      (should-not qq-search--loading)
      (should-not qq-search--error)
      (should (equal (alist-get 'query (plist-get (cadr calls) :params)) "[a.*]"))
      (should (equal (plist-get old :method) "message.search")))))

(ert-deftest qq-search-pagination-failure-retries-the-same-opaque-cursor ()
  (qq-search-test-with-ui
    (let ((cursor '((opaque . "page two") (gateway_instance_id . "gateway-a"))))
      (qq-search-refresh)
      (funcall (plist-get (car calls) :success) (qq-search-test-page nil cursor))
      (qq-search--scroll-end nil 1 5000)
      (should (= (length calls) 1))
      (qq-search--scroll-end nil 5000 5000)
      (qq-search--scroll-end nil 5000 5000)
      (should (= (length calls) 2))
      (funcall (plist-get (cadr calls) :failure)
               '((code . "search_failed") (message . "disk busy")) "disk busy")
      (should (equal qq-search--cursor cursor))
      (should (= (length qq-search--hits) 1))
      (should (equal qq-search--error "disk busy"))
      (qq-search--scroll-end nil 5000 5000)
      (should (= (length calls) 2))
      (qq-search--check-scroll)
      (goto-char (point-min))
      (search-forward "重试")
      (backward-char 1)
      (qq-search-open-hit)
      (should (equal (alist-get 'cursor (plist-get (caddr calls) :params)) cursor))
      (funcall (plist-get (caddr calls) :success)
               (qq-search-test-page (list (qq-search-test-item "18"))))
      (should (= (length qq-search--hits) 2))
      (should-not qq-search--cursor)
      (should-not qq-search--error))))

(ert-deftest qq-search-reconnect-rejects-old-row-and-continuation ()
  (qq-search-test-with-ui
    (qq-search-refresh)
    (funcall (plist-get (car calls) :success)
             (qq-search-test-page nil '((opaque . "next"))))
    (setq instance "gateway-b")
    (qq-search--scroll-end nil 5000 5000)
    (should-error (qq-search-retry) :type 'user-error)
    (should-error (qq-search-open-hit (car qq-search--hits)) :type 'user-error)
    (should (= (length calls) 1))
    (qq-search-refresh)
    (should-not qq-search--hits)
    (should-not (alist-get 'cursor (plist-get (cadr calls) :params)))))

(ert-deftest qq-search-ret-uses-exact-group-row-without-message-id ()
  (qq-search-test-with-ui
    (qq-search-refresh)
    (funcall (plist-get (car calls) :success)
             (qq-search-test-page (list (qq-search-test-item "17" t))))
    (let ((chat (generate-new-buffer " *qq search target*"))
          opened center)
      (unwind-protect
          (cl-letf (((symbol-function 'qq-chat--open-buffer)
                     (lambda (session) (setq opened session) chat))
                    ((symbol-function 'pop-to-buffer) (lambda (buffer &rest _) buffer))
                    ((symbol-function 'qq-chat-goto-message)
                     (lambda (target &optional _no-pop) (setq center target))))
            (qq-search-open-hit (car qq-search--hits))
            (should (equal opened (qq-state-session-key 'group "20001")))
            (should (equal center '((kind . "row") (row_key . "17")))))
        (kill-buffer chat)))))

(ert-deftest qq-search-scroll-pagination-has-no-manual-more-control ()
  (qq-search-test-with-ui
    (qq-search-refresh)
    (funcall (plist-get (car calls) :success)
             (qq-search-test-page nil '((opaque . "next"))))
    (qq-search--check-scroll)
    (should-not (lookup-key qq-search-mode-map (kbd "N")))
    (should-not (string-match-p "更多记录\\|按 N" (buffer-string))))
  (should-error
   (qq-search-messages "中文" (qq-state-session-key 'dataline "u_peer" "desktop"))
   :type 'user-error))

(ert-deftest qq-search-scroll-observer-fills-short-pages-only-when-displayed ()
  (qq-search-test-with-ui
    (qq-search--install-scroll-observer view)
    (let ((observer qq-search--scroll-observer))
      (unwind-protect
          (progn
            (qq-search--install-scroll-observer view)
            (should (eq observer qq-search--scroll-observer))
            (qq-search-refresh)
            (funcall (plist-get (car calls) :success)
                     (qq-search-test-page nil '((opaque . "page two"))))
            (qq-search--check-scroll)
            (should (= (length calls) 1))
            (save-window-excursion
              (switch-to-buffer buffer)
              (cl-letf (((symbol-function 'appkit-scroll-window-visible-range)
                         (lambda (_window start end) (cons start end))))
                (qq-search--check-scroll)
                (should (= (length calls) 2))
                (appkit-scroll-observer-check observer (selected-window))
                (should (= (length calls) 2))
                (funcall (plist-get (cadr calls) :success)
                         (qq-search-test-page (list (qq-search-test-item "18"))
                                              '((opaque . "page three"))))
                (qq-search--check-scroll)
                (should (= (length calls) 3))
                (funcall (plist-get (caddr calls) :success)
                         (qq-search-test-page (list (qq-search-test-item "19"))))
                (qq-search--check-scroll)
                (qq-search--check-scroll)
                (should (= (length calls) 3))
                (should (= (length qq-search--hits) 3))
                (should-not qq-search--cursor))))
        (appkit-scroll-observer-cancel observer)))))

(ert-deftest qq-search-page-render-preserves-point-and-window-start ()
  (qq-search-test-with-ui
    (save-window-excursion
      (switch-to-buffer buffer)
      (qq-search-refresh)
      (funcall (plist-get (car calls) :success)
               (qq-search-test-page nil '((opaque . "next"))))
      (qq-search--check-scroll)
      (let* ((hit (car qq-search--hits))
             (start (text-property-any (point-min) (point-max) 'qq-search-hit hit))
             (target (+ start 12)))
        (goto-char target)
        (set-window-start (selected-window) start)
        (qq-search--request-page t)
        (qq-search--check-scroll)
        (should (= (point) target))
        (should (= (window-start) start))
        (funcall (plist-get (cadr calls) :success)
                 (qq-search-test-page (list (qq-search-test-item "18"))))
        (qq-search--check-scroll)
        (should (= (point) target))
        (should (= (window-start) start))))))

(ert-deftest qq-search-projection-appends-without-reprinting-retained-rows ()
  (qq-search-test-with-ui
    (qq-search-refresh)
    (funcall (plist-get (car calls) :success)
             (qq-search-test-page nil '((opaque . "next"))))
    (let* ((first (car qq-search--hits))
           (key (qq-search--hit-key first))
           (node (appkit-projection-node projection key))
           (row-projector (symbol-function 'qq-search--project-rows))
           (projections 0))
      (should (= (gethash key prints) 1))
      (cl-letf (((symbol-function 'qq-search--project-rows)
                 (lambda (&rest arguments)
                   (cl-incf projections)
                   (apply row-projector arguments))))
        (qq-search--request-page t)
        (should (= projections 0))
        (should (string-match-p "正在加载更多" (buffer-string)))
        (should (= (gethash key prints) 1))
        (funcall (plist-get (cadr calls) :success)
                 (qq-search-test-page (list (qq-search-test-item "18"))))
        (should (= projections 1)))
      (should (eq node (appkit-projection-node projection key)))
      (should (= (gethash key prints) 1))
      (should (= (gethash (qq-search--hit-key (cadr qq-search--hits)) prints) 1))
      (should (string-match-p "已显示 2 条记录 · 已到末尾" (buffer-string)))
      (should-not (string-match-p "正在加载" (buffer-string))))))

(ert-deftest qq-search-projection-refresh-and-query-focus-the-first-hit ()
  (qq-search-test-with-ui
    (qq-search-refresh)
    (funcall (plist-get (car calls) :success)
             (qq-search-test-page (list (qq-search-test-item "17")
                                        (qq-search-test-item "18"))))
    (let* ((first-key (qq-search--hit-key (car qq-search--hits)))
           (second-key (qq-search--hit-key (cadr qq-search--hits)))
           (second-node (appkit-projection-node projection second-key)))
      (goto-char (+ (ewoc-location second-node) 5))
      ;; Refresh clears old rows while its first page is outstanding.
      (qq-search-refresh)
      (should-not (appkit-projection-keys projection))
      (funcall (plist-get (cadr calls) :success)
               (qq-search-test-page (list (qq-search-test-item "17")
                                          (qq-search-test-item "18"))))
      (should (equal (get-text-property (point) 'qq-search-key) first-key))
      (goto-char (+ (ewoc-location (appkit-projection-node projection second-key)) 5))
      (qq-search-edit-query "[a.*]")
      (funcall (plist-get (caddr calls) :success)
               (qq-search-test-page nil nil "[a.*]"))
      (should (equal (get-text-property (point) 'qq-search-key) first-key))
      (let ((start (point)))
        (search-forward "[a.*]")
        (should (memq 'match (ensure-list (get-text-property (- (point) 2) 'face))))
        (goto-char start)
        (search-forward "中文")
        (should-not (get-text-property (- (point) 1) 'face))))))

(ert-deftest qq-search-projection-reprints-only-a-changed-hit ()
  (qq-search-test-with-ui
    (qq-search-refresh)
    (funcall (plist-get (car calls) :success)
             (qq-search-test-page (list (qq-search-test-item "17")
                                        (qq-search-test-item "18"))))
    (let* ((first-key (qq-search--hit-key (car qq-search--hits)))
           (second (copy-tree (cadr qq-search--hits)))
           (second-key (qq-search--hit-key second))
           (node (appkit-projection-node projection second-key)))
      (setf (alist-get 'text (alist-get 'data
					(car (alist-get 'segments (plist-get second :message)))))
            "中文 updated"
            (nth 1 qq-search--hits) second)
      (qq-search--redisplay (appkit-projection-change-create :full-p t))
      (should (eq node (appkit-projection-node projection second-key)))
      (should (= (gethash first-key prints) 1))
      (should (= (gethash second-key prints) 2))
      (should (string-match-p "中文 updated" (buffer-string))))))

(ert-deftest qq-search-list-preserves-complete-multiline-message-text ()
  (qq-search-test-with-ui
    (let* ((prefix (concat "开头\n  " (make-string 800 ?长) "\n"))
           (suffix (concat "中文\n\n" (make-string 800 ?尾) "  \n结尾"))
           (body (concat prefix suffix))
           (item (qq-search-test-item "17" t)))
      (setf (alist-get 'segments (alist-get 'message item))
            (vector `((kind . "text") (payload . ((text . ,prefix))))
                    `((kind . "text") (payload . ((text . ,suffix))))))
      (qq-search-refresh)
      (funcall (plist-get (car calls) :success) (qq-search-test-page (list item)))
      (goto-char (point-min))
      (should (search-forward body nil t))
      (let ((start (- (point) (length body))))
        (should (equal (plist-get (get-text-property start 'qq-search-hit) :session-key)
                       "group:20001"))
        (should (memq 'match (ensure-list
                              (get-text-property (+ start (length prefix)) 'face)))))
      (should (string-match-p "按消息时间倒序显示" (buffer-string)))
      (should (eq (key-binding (kbd "M-RET")) #'qq-search-preview-hit)))))

(ert-deftest qq-search-pagination-keeps-preview-until-query-is-reset ()
  (qq-search-test-with-ui
    (let ((preview-cancellations 0))
      (cl-letf (((symbol-function 'qq-search-preview-cancel)
                 (lambda (&optional _promote) (cl-incf preview-cancellations))))
        (qq-search-refresh)
        (funcall (plist-get (car calls) :success)
                 (qq-search-test-page nil '((version . 2) (before . "17")
                                            (before_sent_at . 1784700000))))
        (let ((before preview-cancellations))
          (qq-search--request-page t)
          (should (= preview-cancellations before))
          (should (equal (alist-get 'cursor (plist-get (cadr calls) :params))
                         '((version . 2) (before . "17") (before_sent_at . 1784700000))))
          (funcall (plist-get (cadr calls) :success)
                   (qq-search-test-page (list (qq-search-test-item "18"))))
          (qq-search-edit-query "新词")
          (should (> preview-cancellations before)))))))

(ert-deftest qq-search-list-retains-searchable-media-text ()
  (let* ((filename (concat (make-string 100 ?文) "关键词.txt"))
         (message
          `((segments
             ((type . "image") (data . ((summary . "图片关键词"))))
             ((type . "mface") (data . ((summary . "表情关键词"))))
             ((type . "file") (data . ((file_name . ,filename))))
             ((type . "group_file") (data . ((file_name . ,filename))))
             ((type . "card") (data . ((kind . "app") (prompt . "卡片标题")
                                       (summary . "卡片关键词\n第二行"))))
             ((type . "card") (data . ((kind . "forward")
                                       (presentation . ((prompt . "聊天记录")
							(summary . "转发关键词"))))))
             ((type . "face") (data . ((description . "原生表情关键词"))))
             ((type . "__unsupported") (data . ((fallback_text . "未支持关键词\n下一行")))))))
         (text (qq-search--message-text message)))
    (dolist (expected (list "图片关键词" "表情关键词" filename
                            "卡片标题\n卡片关键词\n第二行" "聊天记录\n转发关键词"
                            "原生表情关键词" "未支持关键词\n下一行"))
      (should (string-match-p (regexp-quote expected) text)))
    (with-temp-buffer
      (let ((qq-search--query "关键词"))
        (qq-search--insert-preview text)
        (goto-char (point-min))
        (while (search-forward "关键词" nil t)
          (should (memq 'match (ensure-list (get-text-property (- (point) 3) 'face)))))))))

