(ert-deftest qq-search-inline-preview-keeps-filter-in-original-chat ()
  (require 'qq-search-preview)
  (save-window-excursion
    (qq-search-test-with-chat
      (switch-to-buffer chat)
      (qq-search-chat "中文")
      (funcall (plist-get (car calls) :success)
               (qq-search-test-page (list (qq-search-test-group-item "17"))))
      (goto-char (point-min))
      (search-forward "中文")
      (let ((source-window (selected-window))
            (position (point))
            (start (window-start))
            preview-buffer requested)
        (unwind-protect
            (cl-letf (((symbol-function 'qq-chat--open-around)
                       (lambda (center)
                         (setq preview-buffer (current-buffer) requested center))))
              (qq-search-preview-hit)
              (should (eq (current-buffer) chat))
              (should (eq (selected-window) source-window))
              (should (= (point) position))
              (should (= (window-start) start))
              (should qq-search--inline-p)
              (should (equal requested '((kind . "row") (row_key . "17"))))
              (should (buffer-live-p preview-buffer))
              (should-not (eq preview-buffer chat))
              (with-current-buffer preview-buffer
                (should (derived-mode-p 'qq-chat-mode))
                (should qq-chat--preview-p)
                (should-not qq-search--inline-p)
                (should (equal (qq-chat--view-id) '(chat-preview "group:20001"))))
              (should (eq (key-binding (kbd "M-RET")) #'qq-search-preview-hit)))
          (qq-search-preview-cancel)
          (when (buffer-live-p preview-buffer) (kill-buffer preview-buffer)))))))

