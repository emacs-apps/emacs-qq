(ert-deftest qq-search-inline-prepends-pages-without-moving-current-message ()
  (qq-search-test-with-chat
    (qq-search-chat "中文")
    (funcall (plist-get (car calls) :success)
             (qq-search-test-page (list (qq-search-test-group-item "17")) '((before . "17"))))
    (goto-char (point-min))
    (search-forward "中文")
    (let ((anchor (get-text-property (point) 'qq-chat-message-anchor))
          (node (appkit-chat-timeline-node (get-text-property (point) 'qq-chat-message-anchor))))
      (qq-chat--maybe-auto-load-older (point-min))
      ;; Pending and exhausted searches must not enqueue render/scroll loops.
      (cl-letf (((symbol-function 'qq-chat--request-callback-sync)
                 (lambda (&rest _) (ert-fail "Pending search scheduled another edge render"))))
        (qq-chat--maybe-auto-load-older (point-min)))
      (funcall (plist-get (cadr calls) :success)
               (qq-search-test-page (list (qq-search-test-group-item "16"))))
      (should (equal (get-text-property (point) 'qq-chat-message-anchor) anchor))
      (should (eq (appkit-chat-timeline-node anchor) node))
      (should (equal (mapcar (lambda (m) (alist-get 'message-seq m))
                            (qq-chat--timeline-messages))
                     '("16" "17")))
      (cl-letf (((symbol-function 'qq-chat--request-callback-sync)
                 (lambda (&rest _) (ert-fail "Exhausted search scheduled another edge render"))))
        (qq-chat--maybe-auto-load-older (point-min))))))

(ert-deftest qq-search-refresh-while-pending-keeps-the-new-result ()
